# ==============================================================================
# RADHA KIRANA VOICE AI AGENT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file to source control.

# Google Gemini API Key (Required for intelligent multi-lingual intent parsing)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Audio Pipeline Mode:
# 'GNANI' = Production Indic STT (prisma-v3.0) + Indic TTS (timbre-v2.5) via Gnani.ai
# 'DEV'   = 100% Free local CUDA Faster-Whisper + Edge-TTS (Zero credit burn)
AUDIO_MODE=GNANI

# Gnani.ai API Key (Required if AUDIO_MODE=GNANI)
# Get credentials at: https://vachana.ai/
GNANI_API_KEY=your_gnani_vachana_api_key_here

# Default Spoken Voice Profile (Gnani: 'Nalini', Edge-TTS: 'hi-IN-SwaraNeural')
DEFAULT_VOICE=Nalini

# Store Details
STORE_NAME=Shree Ganesh Kirana Store

# Server Network Configuration
HOST=0.0.0.0
PORT=8000

# Google Sheets Live Cloud Synchronization (Optional)
# SPREADSHEET_ID=your_google_spreadsheet_id_here
# ORDERS_LOG_SHEET_ID=your_orders_sheet_id_here
# PRICE_CATALOG_SHEET_ID=your_price_catalog_sheet_id_here

# Telegram Bot Instant Order Alerts (Optional)
# Create a bot via @BotFather on Telegram to obtain your bot token
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# TELEGRAM_CHAT_ID=your_telegram_chat_id_here
